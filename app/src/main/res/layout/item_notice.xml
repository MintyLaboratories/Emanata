<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the About screen: a component or link and its license or address. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_4"
    android:paddingVertical="@dimen/space_2">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.ComicReader.ItemTitle"
        tools:text="Apache Commons Compress" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.ComicReader.ItemSubtitle"
        tools:text="Apache License 2.0" />
</LinearLayout>
