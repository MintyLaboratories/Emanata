<?xml version="1.0" encoding="utf-8"?>
<!-- Network shares stay on this device: their passwords are sealed by a key that never leaves it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="shares.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="shares.xml" />
    </device-transfer>
</data-extraction-rules>
