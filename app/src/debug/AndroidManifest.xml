<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Checks a book read through the share provider, from a process of its own kept in the foreground; only the shell (DUMP) may start it. -->
        <service
            android:name="com.infinity.comicreader.debug.ShareCheckService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:process=":sharecheck"
            android:permission="android.permission.DUMP" />
        <!-- Measures read speed from a share, from a process of its own kept in the foreground; only the shell may start it. -->
        <service
            android:name="com.infinity.comicreader.debug.ShareSpeedService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:process=":sharespeed"
            android:permission="android.permission.DUMP" />
        <!-- Checks the native Book ID hash and times finding IDs, in the app's own process (its index); only the shell may start it. -->
        <service
            android:name="com.infinity.comicreader.debug.BookIdCheckService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP" />
        <!-- Checks compaction and times it, in the app's own process (its library); only the shell may start it. -->
        <service
            android:name="com.infinity.comicreader.debug.CompactCheckService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP" />
        <!-- Times reading sessions and library grids, driving the app as a person would; only the shell may start it. -->
        <activity
            android:name="com.infinity.comicreader.debug.BenchActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <!-- Opens a book in the reader for checks on a device; only the shell may start it. -->
        <activity
            android:name="com.infinity.comicreader.debug.ReaderOpenActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
