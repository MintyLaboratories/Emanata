<?xml version="1.0" encoding="utf-8"?>
<!-- An AI model picker's row (ModelPicker): radio, short name and speed, info button; a family's level slider; what the info button shows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ai_model_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ai_model_row_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ai_choice_start"
        android:paddingTop="@dimen/ai_model_row_padding"
        android:paddingEnd="@dimen/ai_model_row_end"
        android:paddingBottom="@dimen/ai_model_row_padding">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/ai_model_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ai_model_name_start"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ai_model_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:id="@+id/ai_model_speed_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ai_model_speed_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="@string/ai_rating_speed"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.infinity.comicreader.ui.StarsView
                    android:id="@+id/ai_model_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/ai_model_info"
            android:layout_width="@dimen/ai_model_info_size"
            android:layout_height="@dimen/ai_model_info_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:src="@drawable/ic_info" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ai_model_level"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ai_model_detail_start"
        android:paddingEnd="@dimen/ai_model_row_end"
        android:visibility="gone">

        <TextView
            android:id="@+id/ai_model_level_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:text="@string/ai_model_level"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.slider.Slider
            android:id="@+id/ai_model_level_slider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:stepSize="1"
            android:value="0"
            android:valueFrom="0"
            android:valueTo="1"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/ai_model_level_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:minEms="2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ai_model_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ai_model_detail_start"
        android:paddingEnd="?attr/dialogPreferredPadding"
        android:paddingBottom="@dimen/ai_model_row_padding"
        android:visibility="gone">

        <TextView
            android:id="@+id/ai_model_full_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface" />

        <TableLayout
            android:id="@+id/ai_model_ratings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:shrinkColumns="2" />

        <TextView
            android:id="@+id/ai_model_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.1"
            android:textAlignment="viewStart"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</LinearLayout>
