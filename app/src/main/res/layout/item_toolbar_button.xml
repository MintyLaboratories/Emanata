<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the "Toolbar buttons" setting: shown or not, and a handle to drag it into place. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfaceContainerHigh"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/toolbar_button_shown"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="48dp"
        android:paddingStart="8dp" />

    <ImageView
        android:id="@+id/toolbar_button_handle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/toolbar_button_drag"
        android:scaleType="center"
        android:src="@drawable/ic_drag_handle" />
</LinearLayout>
