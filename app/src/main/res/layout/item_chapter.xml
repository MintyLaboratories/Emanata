<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the chapter drawer: the chapter's name and its pages. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_chapter_item"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_3"
    android:paddingVertical="@dimen/space_2">

    <TextView
        android:id="@+id/chapter_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.ComicReader.ItemTitle"
        tools:text="Part 2" />

    <TextView
        android:id="@+id/chapter_pages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.ComicReader.ItemSubtitle"
        tools:text="Pages 13–24" />
</LinearLayout>
