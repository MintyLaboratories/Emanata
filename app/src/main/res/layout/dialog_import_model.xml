<?xml version="1.0" encoding="utf-8"?>
<!-- An imported model, checked: what the check found, its name and step, and the warning about heavy models. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="@dimen/space_2">

        <TextView
            android:id="@+id/import_found"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/import_name_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:hint="@string/ai_import_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/import_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="60"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <RadioGroup
            android:id="@+id/import_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/import_steps_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ai_import_steps_keep"
            android:textAppearance="@style/TextAppearance.Emanata.ItemSubtitle" />

        <TextView
            android:id="@+id/import_heavy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/ai_import_heavy"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorError" />
    </LinearLayout>
</ScrollView>
