<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Checks a book read through the share provider, from a process of its own kept in the foreground; only the shell (DUMP) may start it. -->
        <service
            android:name="com.infinity.comicreader.debug.ShareCheckService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:process=":sharecheck"
            android:permission="android.permission.DUMP" />
        <!-- Measures read speed from a share, from a process of its own kept in the foreground; only the shell may start it. -->
        <service
            android:name="com.infinity.comicreader.debug.ShareSpeedService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:process=":sharespeed"
            android:permission="android.permission.DUMP" />
        <!-- Checks the native Book ID hash and times finding IDs, in the app's own process (its index); only the shell may start it. -->
        <service
            android:name="com.infinity.comicreader.debug.BookIdCheckService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP" />
        <!-- Checks compaction and times it, in the app's own process (its library); only the shell may start it. -->
        <service
            android:name="com.infinity.comicreader.debug.CompactCheckService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP" />
        <!-- Checks the native resampler against its model and times each engine, in the app's own process; only the shell may start it. -->
        <service
            android:name="com.infinity.comicreader.debug.ResampleCheckService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP" />
        <!-- Checks native sharpening against its model and times it, in the app's own process; only the shell may start it. -->
        <service
            android:name="com.infinity.comicreader.debug.SharpenCheckService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP" />
        <!-- Checks native JPEG XL page decodes against jxl-coder's and times each decoder, in the app's own process; only the shell may start it. -->
        <service
            android:name="com.infinity.comicreader.debug.DecodeCheckService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP" />
        <!-- Runs an AI model end to end on synthetic pages and times it, in the app's own process; only the shell may start it. -->
        <service
            android:name="com.infinity.comicreader.debug.AiCheckService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP" />
        <!-- Times the cover text detector on real covers and finds their tallest text, in the app's own process; only the shell may start it. -->
        <service
            android:name="com.infinity.comicreader.debug.CoverFocusCheckService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP" />
        <!-- Times the similar-books search over a folder's books for each worker count, in the app's own process; only the shell may start it. -->
        <service
            android:name="com.infinity.comicreader.debug.SimilarCheckService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:permission="android.permission.DUMP" />
        <!-- Times reading sessions and library grids, driving the app as a person would; only the shell may start it. -->
        <activity
            android:name="com.infinity.comicreader.debug.BenchActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <!-- Shows per-device calibration and runs it again; only the shell may start it. A start while it is on top reaches it (onNewIntent). -->
        <activity
            android:name="com.infinity.comicreader.debug.CalibrationActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:permission="android.permission.DUMP" />
        <!-- Opens a book in the reader for checks on a device; only the shell may start it. -->
        <activity
            android:name="com.infinity.comicreader.debug.ReaderOpenActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
