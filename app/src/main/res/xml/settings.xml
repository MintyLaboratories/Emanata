<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        app:defaultValue="true"
        app:key="pref_keep_simple"
        app:summary="@string/pref_keep_simple_desc"
        app:title="@string/pref_keep_simple" />

    <com.infinity.comicreader.ui.SectionCategory
        app:key="section_general"
        app:title="@string/pref_cat_general">
        <ListPreference
            app:defaultValue="system"
            app:entries="@array/theme_entries"
            app:entryValues="@array/theme_values"
            app:key="pref_theme"
            app:title="@string/pref_theme"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="system"
            app:entries="@array/locale_entries"
            app:entryValues="@array/locale_values"
            app:key="pref_locale"
            app:title="@string/pref_language"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="auto"
            app:entries="@array/charset_entries"
            app:entryValues="@array/charset_values"
            app:key="pref_name_charset"
            app:title="@string/pref_charset"
            app:useSimpleSummaryProvider="true">
            <extra
                android:name="advanced"
                android:value="true" />
        </ListPreference>
    </com.infinity.comicreader.ui.SectionCategory>

    <com.infinity.comicreader.ui.CollapsibleCategory
        app:key="section_appearance"
        app:title="@string/pref_cat_appearance">
        <ListPreference
            app:defaultValue="double"
            app:entries="@array/title_display_entries"
            app:entryValues="@array/title_display_values"
            app:key="pref_title_display"
            app:title="@string/pref_title_display"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_shorten_prefixes"
            app:summary="@string/pref_shorten_prefixes_desc"
            app:title="@string/pref_shorten_prefixes" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_list_pathview"
            app:title="@string/pref_list_pathview" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_list_statusbar"
            app:title="@string/pref_list_statusbar" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_list_quickfab"
            app:title="@string/pref_list_quickfab" />
        <ListPreference
            app:defaultValue="layout"
            app:dependency="pref_list_quickfab"
            app:key="pref_fab_tap"
            app:title="@string/pref_fab_tap"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:dependency="pref_list_quickfab"
            app:key="view_ring"
            app:persistent="false"
            app:title="@string/pref_view_ring" />
        <Preference
            app:key="toolbar_buttons"
            app:persistent="false"
            app:title="@string/pref_toolbar_buttons" />
        <Preference
            app:key="more_actions"
            app:persistent="false"
            app:title="@string/pref_more_actions" />
        <Preference
            app:key="page_actions"
            app:persistent="false"
            app:title="@string/pref_page_actions" />
        <ListPreference
            app:defaultValue="open"
            app:key="pref_fab_one"
            app:title="@string/pref_fab_one"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="move"
            app:key="pref_fab_many"
            app:title="@string/pref_fab_many"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="right"
            app:entries="@array/handed_entries"
            app:entryValues="@array/handed_values"
            app:key="pref_handed"
            app:title="@string/pref_handed"
            app:useSimpleSummaryProvider="true" />
    </com.infinity.comicreader.ui.CollapsibleCategory>

    <com.infinity.comicreader.ui.CollapsibleCategory
        app:key="section_reader"
        app:title="@string/pref_cat_reader">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_fullscreen"
            app:title="@string/pref_fullscreen" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_keep_screen_on"
            app:title="@string/pref_keep_on" />
        <ListPreference
            app:defaultValue="ask"
            app:entries="@array/resume_mode_entries"
            app:entryValues="@array/resume_mode_values"
            app:key="pref_resume_mode"
            app:title="@string/pref_resume"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_auto_next"
            app:summary="@string/pref_auto_next_desc"
            app:title="@string/pref_auto_next" />
        <ListPreference
            app:defaultValue="2"
            app:entries="@array/prev_chapter_backs_entries"
            app:entryValues="@array/prev_chapter_backs_values"
            app:key="pref_prev_chapter_backs"
            app:title="@string/pref_prev_chapter_backs"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="ltr"
            app:entries="@array/reading_dir_entries"
            app:entryValues="@array/reading_dir_values"
            app:key="pref_reading_dir"
            app:title="@string/pref_reading_dir"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_detect_direction"
            app:summary="@string/pref_detect_direction_desc"
            app:title="@string/pref_detect_direction" />
        <ListPreference
            app:defaultValue="paged"
            app:entries="@array/page_mode_entries"
            app:entryValues="@array/page_mode_values"
            app:key="pref_page_mode"
            app:title="@string/pref_page_mode"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="screen"
            app:entries="@array/fit_entries"
            app:entryValues="@array/fit_values"
            app:key="pref_fit"
            app:title="@string/pref_fit"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="none"
            app:entries="@array/filter_entries"
            app:entryValues="@array/filter_values"
            app:key="pref_filter"
            app:title="@string/pref_filter"
            app:useSimpleSummaryProvider="true" />
        <SeekBarPreference
            android:max="48"
            app:defaultValue="0"
            app:key="pref_page_spacing"
            app:min="0"
            app:showSeekBarValue="true"
            app:title="@string/pref_page_spacing" />
        <ListPreference
            app:defaultValue="off"
            app:entries="@array/two_page_entries"
            app:entryValues="@array/two_page_values"
            app:key="pref_two_page_mode"
            app:title="@string/pref_two_page"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_cover_alone"
            app:summary="@string/pref_cover_alone_desc"
            app:title="@string/pref_cover_alone" />
        <ListPreference
            app:defaultValue="merge"
            app:entries="@array/spreads_entries"
            app:entryValues="@array/spreads_values"
            app:key="pref_spreads"
            app:title="@string/pref_spreads"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_join_spreads"
            app:summary="@string/pref_join_spreads_desc"
            app:title="@string/pref_join_spreads" />
        <!-- Summary: the choice and what it does (SettingsFragment). -->
        <ListPreference
            app:defaultValue="image"
            app:entries="@array/wide_pages_entries"
            app:entryValues="@array/wide_pages_values"
            app:key="pref_wide_pages"
            app:title="@string/pref_wide_pages" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_auto_crop"
            app:summary="@string/pref_auto_crop_desc"
            app:title="@string/menu_auto_crop" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_linear_light"
            app:summary="@string/pref_linear_light_desc"
            app:title="@string/pref_linear_light" />
        <ListPreference
            app:defaultValue="lanczos3"
            app:entries="@array/scale_entries"
            app:entryValues="@array/scale_values"
            app:key="pref_scale_pages"
            app:title="@string/pref_scale_pages"
            app:useSimpleSummaryProvider="true">
            <extra
                android:name="advanced"
                android:value="true" />
        </ListPreference>
        <ListPreference
            app:defaultValue="lanczos3"
            app:entries="@array/scale_entries"
            app:entryValues="@array/scale_values"
            app:key="pref_scale_zoom"
            app:title="@string/pref_scale_zoom"
            app:useSimpleSummaryProvider="true">
            <extra
                android:name="advanced"
                android:value="true" />
        </ListPreference>
        <ListPreference
            app:defaultValue="lanczos3"
            app:entries="@array/scale_entries"
            app:entryValues="@array/scale_values"
            app:key="pref_scale_thumbs"
            app:title="@string/pref_scale_thumbs"
            app:useSimpleSummaryProvider="true">
            <extra
                android:name="advanced"
                android:value="true" />
        </ListPreference>
        <SeekBarPreference
            android:max="100"
            app:defaultValue="0"
            app:key="pref_ring_up"
            app:min="0"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true"
            app:summary="@string/pref_ring_desc"
            app:title="@string/pref_ring_up">
            <extra
                android:name="advanced"
                android:value="true" />
        </SeekBarPreference>
        <SeekBarPreference
            android:max="100"
            app:defaultValue="50"
            app:key="pref_ring_down"
            app:min="0"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true"
            app:summary="@string/pref_ring_desc"
            app:title="@string/pref_ring_down">
            <extra
                android:name="advanced"
                android:value="true" />
        </SeekBarPreference>
        <SeekBarPreference
            android:max="100"
            app:defaultValue="0"
            app:key="pref_sharpen"
            app:min="0"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true"
            app:summary="@string/pref_sharpen_desc"
            app:title="@string/pref_sharpen">
            <extra
                android:name="advanced"
                android:value="true" />
        </SeekBarPreference>
        <SeekBarPreference
            android:max="200"
            app:defaultValue="120"
            app:key="pref_tall_threshold"
            app:min="101"
            app:seekBarIncrement="1"
            app:showSeekBarValue="false"
            app:title="@string/pref_tall_threshold"
            app:updatesContinuously="true">
            <extra
                android:name="advanced"
                android:value="true" />
        </SeekBarPreference>
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_per_series"
            app:summary="@string/pref_per_series_desc"
            app:title="@string/pref_per_series" />
        <ListPreference
            app:defaultValue="2"
            app:entries="@array/preload_entries"
            app:entryValues="@array/preload_values"
            app:key="pref_preload"
            app:title="@string/pref_preload"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="3"
            app:key="pref_auto_scroll_speed"
            app:title="@string/pref_auto_speed"
            app:useSimpleSummaryProvider="true" />
    </com.infinity.comicreader.ui.CollapsibleCategory>

    <com.infinity.comicreader.ui.CollapsibleCategory
        app:key="section_adjustments"
        app:title="@string/pref_cat_adjustments">
        <SeekBarPreference
            android:max="100"
            app:defaultValue="0"
            app:key="pref_adjust_brightness"
            app:min="-100"
            app:showSeekBarValue="true"
            app:title="@string/adjust_brightness" />
        <SeekBarPreference
            android:max="100"
            app:defaultValue="0"
            app:key="pref_adjust_contrast"
            app:min="-100"
            app:showSeekBarValue="true"
            app:title="@string/adjust_contrast" />
        <SeekBarPreference
            android:max="100"
            app:defaultValue="0"
            app:key="pref_adjust_saturation"
            app:min="-100"
            app:showSeekBarValue="true"
            app:title="@string/adjust_saturation" />
    </com.infinity.comicreader.ui.CollapsibleCategory>

    <com.infinity.comicreader.ui.CollapsibleCategory
        app:key="section_ai"
        app:title="@string/pref_cat_ai">
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_ai"
            app:summary="@string/pref_ai_desc"
            app:title="@string/pref_ai" />
        <!--
          Two default chains, each a header, a picker per step, then its load estimate: a book runs one (ChainKind)
          unless it has its own.
          Entries come from the model catalog; only choices are stored, no defaults (SettingsFragment).
        -->
        <com.infinity.comicreader.ui.AiChainPreference
            app:dependency="pref_ai"
            app:key="ai_chain_manga"
            app:summary="@string/ai_chain_manga_desc"
            app:title="@string/ai_chain_manga" />
        <ListPreference
            app:dependency="pref_ai"
            app:key="pref_ai_manga_artifacts"
            app:title="@string/pref_ai_artifacts">
            <extra
                android:name="advanced"
                android:value="true" />
        </ListPreference>
        <ListPreference
            app:dependency="pref_ai"
            app:key="pref_ai_manga_descreen"
            app:title="@string/pref_ai_descreen">
            <extra
                android:name="advanced"
                android:value="true" />
        </ListPreference>
        <ListPreference
            app:dependency="pref_ai"
            app:key="pref_ai_manga_upscale"
            app:title="@string/pref_ai_upscale" />
        <com.infinity.comicreader.ui.AiLoadPreference
            app:dependency="pref_ai"
            app:key="ai_load_manga" />
        <com.infinity.comicreader.ui.AiChainPreference
            app:dependency="pref_ai"
            app:key="ai_chain_other"
            app:summary="@string/ai_chain_other_desc"
            app:title="@string/ai_chain_other" />
        <ListPreference
            app:dependency="pref_ai"
            app:key="pref_ai_artifacts"
            app:title="@string/pref_ai_artifacts">
            <extra
                android:name="advanced"
                android:value="true" />
        </ListPreference>
        <ListPreference
            app:dependency="pref_ai"
            app:key="pref_ai_descreen"
            app:title="@string/pref_ai_descreen">
            <extra
                android:name="advanced"
                android:value="true" />
        </ListPreference>
        <ListPreference
            app:dependency="pref_ai"
            app:key="pref_ai_upscale"
            app:title="@string/pref_ai_upscale" />
        <com.infinity.comicreader.ui.AiLoadPreference
            app:dependency="pref_ai"
            app:key="ai_load_other" />
        <!-- Stores Prefs.aiThresholds itself, under two keys. -->
        <com.infinity.comicreader.ui.AiSizePreference
            app:dependency="pref_ai"
            app:key="pref_ai_sizes"
            app:summary="@string/pref_ai_sizes_desc"
            app:title="@string/pref_ai_sizes">
            <extra
                android:name="advanced"
                android:value="true" />
        </com.infinity.comicreader.ui.AiSizePreference>
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_ai_dot"
            app:summary="@string/pref_ai_dot_desc"
            app:title="@string/pref_ai_dot">
            <extra
                android:name="advanced"
                android:value="true" />
        </SwitchPreferenceCompat>
        <Preference
            app:key="ai_models"
            app:persistent="false"
            app:title="@string/pref_ai_models" />
    </com.infinity.comicreader.ui.CollapsibleCategory>

    <com.infinity.comicreader.ui.CollapsibleCategory
        app:key="section_gestures"
        app:title="@string/pref_cat_gestures">
        <ListPreference
            app:defaultValue="left_right"
            app:entries="@array/tap_zone_entries"
            app:entryValues="@array/tap_zone_values"
            app:key="pref_tap_zone_layout"
            app:title="@string/pref_tap_zones"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_tap_zones_mirror"
            app:title="@string/pref_tap_zones_mirror" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_volume_keys"
            app:title="@string/pref_volume_keys" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_brightness_gesture"
            app:title="@string/pref_brightness_gesture" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_double_tap"
            app:summary="@string/pref_double_tap_desc"
            app:title="@string/pref_double_tap" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_fling"
            app:summary="@string/pref_fling_desc"
            app:title="@string/pref_fling" />
    </com.infinity.comicreader.ui.CollapsibleCategory>

    <com.infinity.comicreader.ui.CollapsibleCategory
        app:key="section_library"
        app:title="@string/pref_cat_list">
        <ListPreference
            app:defaultValue="browse"
            app:entries="@array/startup_tab_entries"
            app:entryValues="@array/startup_tab_values"
            app:key="pref_startup_tab"
            app:title="@string/pref_startup_tab"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="last"
            app:entries="@array/startup_location_entries"
            app:entryValues="@array/startup_location_values"
            app:key="pref_startup_location"
            app:title="@string/pref_startup_location" />
        <ListPreference
            app:defaultValue="ask"
            app:entries="@array/resume_mode_entries"
            app:entryValues="@array/resume_mode_values"
            app:key="pref_startup_resume"
            app:title="@string/pref_startup_resume"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_show_hidden"
            app:title="@string/pref_show_hidden" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_thumbs"
            app:title="@string/pref_thumbs" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_suggest_repack"
            app:summary="@string/pref_suggest_repack_desc"
            app:title="@string/pref_suggest_repack" />
        <ListPreference
            app:defaultValue="2:3"
            app:entries="@array/cover_shape_entries"
            app:entryValues="@array/cover_shape_values"
            app:key="pref_cover_shape"
            app:title="@string/pref_cover_shape"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="auto"
            app:entries="@array/thumb_fit_entries"
            app:entryValues="@array/thumb_fit_values"
            app:key="pref_thumb_fit"
            app:title="@string/pref_thumb_fit"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="top"
            app:entries="@array/crop_anchor_entries"
            app:entryValues="@array/crop_anchor_values"
            app:key="pref_crop_anchor"
            app:title="@string/pref_crop_anchor"
            app:useSimpleSummaryProvider="true" />
        <SeekBarPreference
            android:max="32"
            app:defaultValue="8"
            app:key="pref_cover_spacing"
            app:min="0"
            app:seekBarIncrement="2"
            app:showSeekBarValue="true"
            app:summary="@string/pref_cover_spacing_desc"
            app:title="@string/pref_cover_spacing" />
        <!-- One entry per tab; each opens that tab's view settings. -->
        <Preference
            app:key="view_browse"
            app:persistent="false"
            app:title="@string/view_browse" />
        <Preference
            app:key="view_favorites"
            app:persistent="false"
            app:title="@string/view_favorites" />
        <Preference
            app:key="view_history"
            app:persistent="false"
            app:title="@string/view_history" />
        <Preference
            app:key="view_bookmarks"
            app:persistent="false"
            app:title="@string/view_bookmarks" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_group_favorites"
            app:summary="@string/pref_group_favorites_desc"
            app:title="@string/pref_group_favorites" />
        <ListPreference
            app:defaultValue="peek_open"
            app:entries="@array/pinch_peek_entries"
            app:entryValues="@array/pinch_peek_values"
            app:key="pref_pinch_peek"
            app:title="@string/pref_pinch_peek"
            app:useSimpleSummaryProvider="true" />
    </com.infinity.comicreader.ui.CollapsibleCategory>

    <com.infinity.comicreader.ui.CollapsibleCategory
        app:key="section_network"
        app:title="@string/pref_cat_network">
        <ListPreference
            app:defaultValue="2048"
            app:entries="@array/network_cache_entries"
            app:entryValues="@array/network_cache_values"
            app:key="pref_network_cache"
            app:summary="@string/pref_network_cache_desc"
            app:title="@string/pref_network_cache" />
        <ListPreference
            app:defaultValue="30"
            app:entries="@array/network_timeout_entries"
            app:entryValues="@array/network_timeout_values"
            app:key="pref_network_timeout"
            app:title="@string/pref_network_timeout"
            app:useSimpleSummaryProvider="true">
            <extra
                android:name="advanced"
                android:value="true" />
        </ListPreference>
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_similar_shares"
            app:summary="@string/pref_similar_shares_desc"
            app:title="@string/pref_similar_shares" />
        <!-- Opens a multiple choice; stored by Prefs as a comma-separated string. -->
        <Preference
            app:key="pref_metered_skip"
            app:persistent="false"
            app:title="@string/pref_metered_skip" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_metered_warn"
            app:title="@string/pref_metered_warn" />
        <ListPreference
            app:defaultValue="100"
            app:dependency="pref_metered_warn"
            app:entries="@array/metered_warn_entries"
            app:entryValues="@array/metered_warn_values"
            app:key="pref_metered_warn_mb"
            app:title="@string/pref_metered_warn_mb"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:key="pref_slow_skip"
            app:persistent="false"
            app:title="@string/pref_slow_skip" />
    </com.infinity.comicreader.ui.CollapsibleCategory>

    <com.infinity.comicreader.ui.CollapsibleCategory
        app:key="section_battery"
        app:title="@string/pref_cat_battery">
        <Preference
            app:key="battery_saver_state"
            app:persistent="false"
            app:selectable="false"
            app:title="@string/battery_saver" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_saver_covers"
            app:summary="@string/pref_saver_covers_desc"
            app:title="@string/pref_saver_covers" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_saver_read_ahead"
            app:summary="@string/pref_saver_read_ahead_desc"
            app:title="@string/pref_saver_read_ahead" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_saver_scans"
            app:summary="@string/pref_saver_scans_desc"
            app:title="@string/pref_saver_scans" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_saver_ai"
            app:summary="@string/pref_saver_ai_desc"
            app:title="@string/pref_saver_ai" />
    </com.infinity.comicreader.ui.CollapsibleCategory>

    <com.infinity.comicreader.ui.CollapsibleCategory
        app:key="section_performance"
        app:title="@string/pref_cat_performance">
        <Preference
            app:key="pref_recalibrate"
            app:persistent="false"
            app:title="@string/pref_recalibrate" />
    </com.infinity.comicreader.ui.CollapsibleCategory>

    <com.infinity.comicreader.ui.CollapsibleCategory
        app:key="section_data"
        app:title="@string/pref_cat_data">
        <Preference
            app:key="pref_stats"
            app:title="@string/menu_stats" />
        <Preference
