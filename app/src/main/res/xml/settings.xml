<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_cat_general">
        <ListPreference
            app:defaultValue="system"
            app:entries="@array/theme_entries"
            app:entryValues="@array/theme_values"
            app:key="pref_theme"
            app:title="@string/pref_theme"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="system"
            app:entries="@array/locale_entries"
            app:entryValues="@array/locale_values"
            app:key="pref_locale"
            app:title="@string/pref_language"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="UTF-8"
            app:entries="@array/charset_entries"
            app:entryValues="@array/charset_values"
            app:key="pref_charset"
            app:title="@string/pref_charset"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_appearance">
        <ListPreference
            app:defaultValue="double"
            app:entries="@array/title_display_entries"
            app:entryValues="@array/title_display_values"
            app:key="pref_title_display"
            app:title="@string/pref_title_display"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_shorten_prefixes"
            app:summary="@string/pref_shorten_prefixes_desc"
            app:title="@string/pref_shorten_prefixes" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_list_pathview"
            app:title="@string/pref_list_pathview" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_list_statusbar"
            app:title="@string/pref_list_statusbar" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_list_quickfab"
            app:title="@string/pref_list_quickfab" />
        <Preference
            app:key="toolbar_buttons"
            app:persistent="false"
            app:title="@string/pref_toolbar_buttons" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_reader">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_fullscreen"
            app:title="@string/pref_fullscreen" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_keep_screen_on"
            app:title="@string/pref_keep_on" />
        <ListPreference
            app:defaultValue="ask"
            app:entries="@array/resume_mode_entries"
            app:entryValues="@array/resume_mode_values"
            app:key="pref_resume_mode"
            app:title="@string/pref_resume"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_auto_next"
            app:summary="@string/pref_auto_next_desc"
            app:title="@string/pref_auto_next" />
        <ListPreference
            app:defaultValue="2"
            app:entries="@array/prev_chapter_backs_entries"
            app:entryValues="@array/prev_chapter_backs_values"
            app:key="pref_prev_chapter_backs"
            app:title="@string/pref_prev_chapter_backs"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="ltr"
            app:entries="@array/reading_dir_entries"
            app:entryValues="@array/reading_dir_values"
            app:key="pref_reading_dir"
            app:title="@string/pref_reading_dir"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_detect_direction"
            app:summary="@string/pref_detect_direction_desc"
            app:title="@string/pref_detect_direction" />
        <ListPreference
            app:defaultValue="paged"
            app:entries="@array/page_mode_entries"
            app:entryValues="@array/page_mode_values"
            app:key="pref_page_mode"
            app:title="@string/pref_page_mode"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="screen"
            app:entries="@array/fit_entries"
            app:entryValues="@array/fit_values"
            app:key="pref_fit"
            app:title="@string/pref_fit"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="none"
            app:entries="@array/filter_entries"
            app:entryValues="@array/filter_values"
            app:key="pref_filter"
            app:title="@string/pref_filter"
            app:useSimpleSummaryProvider="true" />
        <SeekBarPreference
            android:max="48"
            app:defaultValue="0"
            app:key="pref_page_spacing"
            app:min="0"
            app:showSeekBarValue="true"
            app:title="@string/pref_page_spacing" />
        <ListPreference
            app:defaultValue="off"
            app:entries="@array/two_page_entries"
            app:entryValues="@array/two_page_values"
            app:key="pref_two_page_mode"
            app:title="@string/pref_two_page"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_auto_crop"
            app:summary="@string/pref_auto_crop_desc"
            app:title="@string/menu_auto_crop" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_linear_light"
            app:summary="@string/pref_linear_light_desc"
            app:title="@string/pref_linear_light" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_per_series"
            app:summary="@string/pref_per_series_desc"
            app:title="@string/pref_per_series" />
        <ListPreference
            app:defaultValue="2"
            app:entries="@array/preload_entries"
            app:entryValues="@array/preload_values"
            app:key="pref_preload"
            app:title="@string/pref_preload"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="3"
            app:key="pref_auto_scroll_speed"
            app:title="@string/pref_auto_speed"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_adjustments">
        <SeekBarPreference
            android:max="100"
            app:defaultValue="0"
            app:key="pref_adjust_brightness"
            app:min="-100"
            app:showSeekBarValue="true"
            app:title="@string/adjust_brightness" />
        <SeekBarPreference
            android:max="100"
            app:defaultValue="0"
            app:key="pref_adjust_contrast"
            app:min="-100"
            app:showSeekBarValue="true"
            app:title="@string/adjust_contrast" />
        <SeekBarPreference
            android:max="100"
            app:defaultValue="0"
            app:key="pref_adjust_saturation"
            app:min="-100"
            app:showSeekBarValue="true"
            app:title="@string/adjust_saturation" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_gestures">
        <ListPreference
            app:defaultValue="left_right"
            app:entries="@array/tap_zone_entries"
            app:entryValues="@array/tap_zone_values"
            app:key="pref_tap_zone_layout"
            app:title="@string/pref_tap_zones"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_tap_zones_mirror"
            app:title="@string/pref_tap_zones_mirror" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_volume_keys"
            app:title="@string/pref_volume_keys" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_brightness_gesture"
            app:title="@string/pref_brightness_gesture" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_double_tap"
            app:title="@string/pref_double_tap" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_fling"
            app:summary="@string/pref_fling_desc"
            app:title="@string/pref_fling" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_list">
        <ListPreference
            app:defaultValue="browse"
            app:entries="@array/startup_tab_entries"
            app:entryValues="@array/startup_tab_values"
            app:key="pref_startup_tab"
            app:title="@string/pref_startup_tab"
            app:useSimpleSummaryProvider="true" />
        <!-- No default here: an older version's home folder decides it (see Prefs.startupLocation). -->
        <ListPreference
            app:entries="@array/startup_location_entries"
            app:entryValues="@array/startup_location_values"
            app:key="pref_startup_location"
            app:title="@string/pref_startup_location" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="pref_show_hidden"
            app:title="@string/pref_show_hidden" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_thumbs"
            app:title="@string/pref_thumbs" />
        <ListPreference
            app:defaultValue="2:3"
            app:entries="@array/cover_shape_entries"
            app:entryValues="@array/cover_shape_values"
            app:key="pref_cover_shape"
            app:title="@string/pref_cover_shape"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="auto"
            app:entries="@array/thumb_fit_entries"
            app:entryValues="@array/thumb_fit_values"
            app:key="pref_thumb_fit"
            app:title="@string/pref_thumb_fit"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="top"
            app:entries="@array/crop_anchor_entries"
            app:entryValues="@array/crop_anchor_values"
            app:key="pref_crop_anchor"
            app:title="@string/pref_crop_anchor"
            app:useSimpleSummaryProvider="true" />
        <SeekBarPreference
            android:max="32"
            app:defaultValue="8"
            app:key="pref_cover_spacing"
            app:min="0"
            app:seekBarIncrement="2"
            app:showSeekBarValue="true"
            app:summary="@string/pref_cover_spacing_desc"
            app:title="@string/pref_cover_spacing" />
        <!-- One entry per tab; each opens that tab's view settings. -->
        <Preference
            app:key="view_browse"
            app:persistent="false"
            app:title="@string/view_browse" />
        <Preference
            app:key="view_favorites"
            app:persistent="false"
            app:title="@string/view_favorites" />
        <Preference
            app:key="view_history"
            app:persistent="false"
            app:title="@string/view_history" />
        <Preference
            app:key="view_bookmarks"
            app:persistent="false"
            app:title="@string/view_bookmarks" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pref_group_favorites"
            app:summary="@string/pref_group_favorites_desc"
            app:title="@string/pref_group_favorites" />
        <ListPreference
            app:defaultValue="peek_open"
            app:entries="@array/pinch_peek_entries"
            app:entryValues="@array/pinch_peek_values"
            app:key="pref_pinch_peek"
            app:title="@string/pref_pinch_peek"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_data">
        <Preference
            app:key="pref_stats"
            app:title="@string/menu_stats" />
        <Preference
            app:key="pref_backup"
            app:summary="@string/pref_backup_desc"
            app:title="@string/pref_backup" />
        <Preference
            app:key="pref_restore"
            app:summary="@string/pref_restore_desc"
            app:title="@string/pref_restore" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_cache">
        <Preference
            app:key="pref_clear_thumbs"
            app:title="@string/pref_clear_thumbs" />
        <Preference
            app:key="pref_clear_history"
            app:title="@string/pref_clear_history" />
        <Preference
            app:key="pref_clear_bookmarks"
            app:title="@string/pref_clear_bookmarks" />
        <Preference
            app:key="pref_reset"
            app:title="@string/pref_reset" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/about">
        <Preference
            app:key="pref_about"
            app:title="@string/pref_about" />
    </PreferenceCategory>

</PreferenceScreen>
