<?xml version="1.0" encoding="utf-8"?>
<!--
    The network share form: SMB or WebDAV, name, path, user and password (which an edit can
    clear), and whether covers are made; everything else is defaulted. Kept from autofill, so
    password managers neither offer nor save share passwords.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAutofill="noExcludeDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_6"
        android:paddingTop="@dimen/space_3">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/share_kind"
            style="@style/Widget.ComicReader.SheetSegments"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="@dimen/space_2"
            app:checkedButton="@+id/share_kind_smb">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/share_kind_smb"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/share_kind_smb" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/share_kind_webdav"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/share_kind_webdav" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/share_name_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/share_name"
            app:helperText="@string/share_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/share_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/share_path_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:hint="@string/share_path"
            app:helperText="@string/share_path_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/share_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/share_user_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:hint="@string/share_user"
            app:helperText="@string/share_user_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/share_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/share_password_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:hint="@string/share_password"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/share_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/share_password_clear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/share_password_clear"
            android:visibility="gone" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/share_thumbnails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:checked="true"
            android:minHeight="48dp"
            android:text="@string/share_thumbnails" />

        <TextView
            android:id="@+id/share_thumbnails_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_thumbnails_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>
