<?xml version="1.0" encoding="utf-8"?>
<!-- An AI model picker's choice: name and size, its description below, spaced apart from the next. -->
<CheckedTextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@android:id/text1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/listPreferredItemHeightSmall"
    android:gravity="center_vertical"
    android:textAlignment="viewStart"
    android:paddingStart="@dimen/ai_choice_start"
    android:paddingEnd="?attr/dialogPreferredPadding"
    android:paddingTop="@dimen/ai_choice_padding"
    android:paddingBottom="@dimen/ai_choice_padding"
    android:lineSpacingMultiplier="1.1"
    android:textAppearance="?attr/textAppearanceBodyLarge"
    android:textColor="?attr/colorOnSurface"
    app:drawableStartCompat="?android:attr/listChoiceIndicatorSingle"
    android:drawablePadding="20dp" />
