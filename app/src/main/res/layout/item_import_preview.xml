<?xml version="1.0" encoding="utf-8"?>
<!-- One test picture of an import's preview: what it is, then before and after, side by side where they fit, else stacked, fitted to a narrower window; the gap between them is a divider, so both always get the same room. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_4"
    android:orientation="vertical">

    <TextView
        android:id="@+id/import_preview_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        tools:text="Clean art with gradients" />

    <minty.emanata.ui.ButtonRow
        android:id="@+id/import_preview_pair"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:divider="@drawable/gap_space_2"
        android:orientation="horizontal"
        android:showDividers="middle">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/ai_import_preview_before"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <ImageView
                android:id="@+id/import_preview_before"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/ai_import_preview_after"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <ImageView
                android:id="@+id/import_preview_after"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </minty.emanata.ui.ButtonRow>
</LinearLayout>
