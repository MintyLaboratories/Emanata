<?xml version="1.0" encoding="utf-8"?>
<!-- An operation bubble's card: what it does, which item of how many, how far, and Cancel. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/op_card_width"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_3"
        android:paddingEnd="@dimen/space_2"
        android:paddingBottom="@dimen/space_1">

        <TextView
            android:id="@+id/op_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_2"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <TextView
            android:id="@+id/op_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:layout_marginEnd="@dimen/space_2"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/op_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginEnd="@dimen/space_2"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/op_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:layout_marginEnd="@dimen/space_2"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <Button
            android:id="@+id/op_cancel"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/cancel" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
