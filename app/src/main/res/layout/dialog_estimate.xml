<?xml version="1.0" encoding="utf-8"?>
<!-- How long a Convert action takes, under its dialog's message, where it has no other options. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="?attr/dialogPreferredPadding"
    android:paddingTop="@dimen/space_1">

    <TextView
        android:id="@+id/convert_estimate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:visibility="gone" />
</FrameLayout>
