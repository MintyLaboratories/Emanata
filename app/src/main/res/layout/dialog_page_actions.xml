<?xml version="1.0" encoding="utf-8"?>
<!-- The reader's page long-press menu: a fixed row of buttons, then the rows Settings orders. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_2">

        <LinearLayout
            android:id="@+id/page_actions_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_2"
            android:paddingEnd="@dimen/space_2" />

        <View
            android:id="@+id/page_actions_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginBottom="@dimen/space_1"
            android:background="?attr/colorOutlineVariant" />

        <LinearLayout
            android:id="@+id/page_actions_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
