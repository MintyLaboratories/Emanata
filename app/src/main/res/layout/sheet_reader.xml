<?xml version="1.0" encoding="utf-8"?>
<!--
  Reader settings: every reading option in one sheet. "Apply to" at the top says
  whether the Layout group changes this folder's layout or every book's defaults;
  Color and Behavior always apply everywhere. Each single choice is a row of
  segmented buttons, one tap per choice, one always selected.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_5"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/space_5"
        android:paddingBottom="@dimen/space_6">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_reader_settings"
            android:textAppearance="@style/TextAppearance.ComicReader.ItemTitle"
            android:textSize="17sp" />

        <!-- Apply to -->
        <LinearLayout
            android:id="@+id/sheet_scope_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.ComicReader.SheetLabel"
                android:text="@string/sheet_apply_to" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/sheet_scope"
                style="@style/Widget.ComicReader.SheetSegments">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scope_folder"
                    style="@style/Widget.ComicReader.SheetSegment"
                    android:text="@string/scope_folder" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scope_all"
                    style="@style/Widget.ComicReader.SheetSegment"
                    android:text="@string/scope_all" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/sheet_scope_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:textAppearance="@style/TextAppearance.ComicReader.ItemSubtitle"
                tools:text="@string/scope_all_hint" />
        </LinearLayout>

        <!-- Layout -->
        <TextView
            style="@style/Widget.ComicReader.SheetSection"
            android:text="@string/sheet_layout" />

        <TextView
            style="@style/Widget.ComicReader.SheetLabel"
            android:text="@string/menu_page_mode" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/sheet_page_mode"
            style="@style/Widget.ComicReader.SheetSegments">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_paged"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/page_mode_paged" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_continuous"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/page_mode_continuous" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/Widget.ComicReader.SheetLabel"
            android:text="@string/menu_reading_dir" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/sheet_dir"
            style="@style/Widget.ComicReader.SheetSegments">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dir_ltr"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/reading_ltr" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dir_rtl"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/reading_rtl" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dir_ttb"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/reading_ttb" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dir_auto"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/reading_auto" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/sheet_dir_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="@style/TextAppearance.ComicReader.ItemSubtitle"
            tools:text="@string/direction_info" />

        <TextView
            style="@style/Widget.ComicReader.SheetLabel"
            android:text="@string/menu_fit" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/sheet_fit"
            style="@style/Widget.ComicReader.SheetSegments">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_fit_screen"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/fit_screen_short" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_fit_width"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/fit_width_short" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_fit_height"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/fit_height_short" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_fit_stretch"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/menu_fit_stretch" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/Widget.ComicReader.SheetLabel"
            android:text="@string/menu_two_page" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/sheet_two_page"
            style="@style/Widget.ComicReader.SheetSegments">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_two_off"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/two_page_off" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_two_on"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/two_page_on" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_two_landscape"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/two_page_landscape" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sheet_shift"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/menu_shift_pairs" />

        <TextView
            style="@style/Widget.ComicReader.SheetLabel"
            android:text="@string/menu_spreads" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/sheet_spreads"
            style="@style/Widget.ComicReader.SheetSegments">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_spreads_split"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/spreads_split" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_spreads_merge"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/spreads_merge" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sheet_join_spreads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:minHeight="48dp"
            android:text="@string/pref_join_spreads" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sheet_ignore_seams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/menu_ignore_seams" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sheet_auto_crop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:minHeight="48dp"
            android:text="@string/menu_auto_crop" />

        <TextView
            android:id="@+id/sheet_spacing_value"
            style="@style/Widget.ComicReader.SheetLabel"
            android:text="@string/menu_page_spacing"
            tools:text="Page spacing · 0 dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sheet_spacing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="4"
            android:value="0"
            android:valueFrom="0"
            android:valueTo="48" />

        <!-- Color -->
        <TextView
            style="@style/Widget.ComicReader.SheetSection"
            android:text="@string/sheet_color" />

        <TextView
            style="@style/Widget.ComicReader.SheetLabel"
            android:text="@string/menu_filters" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sheet_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_none"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_filter_none" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_invert"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_filter_invert" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_grayscale"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_filter_grayscale" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_contrast"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_filter_contrast" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_sepia"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_filter_sepia" />
        </com.google.android.material.chip.ChipGroup>

        <include
            layout="@layout/view_adjustments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sheet_night"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/menu_night" />

        <!--
          AI processing: this book's own models, or one of the two default chains, picked for
          the book or its whole folder
        -->
        <TextView
            style="@style/Widget.ComicReader.SheetSection"
            android:text="@string/sheet_ai" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/sheet_ai_scope"
            style="@style/Widget.ComicReader.SheetSegments">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ai_book"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/ai_scope_book" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ai_default"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/ai_scope_default" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:id="@+id/sheet_ai_kind_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.ComicReader.SheetLabel"
                android:text="@string/ai_kind_label" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/sheet_ai_kind"
                style="@style/Widget.ComicReader.SheetSegments">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ai_manga"
                    style="@style/Widget.ComicReader.SheetSegment"
                    android:text="@string/ai_chain_manga" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ai_other"
                    style="@style/Widget.ComicReader.SheetSegment"
                    android:text="@string/ai_chain_other" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sheet_ai_kind_folder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/ai_kind_folder" />
        </LinearLayout>

        <TextView
            android:id="@+id/sheet_ai_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="@style/TextAppearance.ComicReader.ItemSubtitle"
            tools:text="@string/ai_scope_default_hint" />

        <TextView
            android:id="@+id/sheet_ai_artifacts_label"
            style="@style/Widget.ComicReader.SheetLabel"
            android:text="@string/ai_step_artifacts" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_ai_artifacts"
            style="@style/Widget.ComicReader.SheetPicker" />

        <TextView
            android:id="@+id/sheet_ai_descreen_label"
            style="@style/Widget.ComicReader.SheetLabel"
            android:text="@string/ai_step_descreen" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_ai_descreen"
            style="@style/Widget.ComicReader.SheetPicker" />

        <TextView
            style="@style/Widget.ComicReader.SheetLabel"
            android:text="@string/ai_step_upscale" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_ai_upscale"
            style="@style/Widget.ComicReader.SheetPicker" />

        <include layout="@layout/view_ai_load" />

        <!-- Behavior -->
        <TextView
            style="@style/Widget.ComicReader.SheetSection"
            android:text="@string/sheet_behavior" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sheet_auto_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/menu_auto_next" />

        <TextView
            android:id="@+id/sheet_auto_speed_value"
            style="@style/Widget.ComicReader.SheetLabel"
            android:text="@string/pref_auto_speed"
            tools:text="Auto-scroll speed · 3 screens/min · 20 s a page" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sheet_auto_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="6"
            android:valueFrom="0"
            android:valueTo="16" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sheet_keep_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/menu_keep_on" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sheet_fullscreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/menu_fullscreen" />

        <TextView
            style="@style/Widget.ComicReader.SheetLabel"
            android:text="@string/menu_orientation" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/sheet_orientation"
            style="@style/Widget.ComicReader.SheetSegments">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_orient_default"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/orientation_default" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_orient_portrait"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/orientation_portrait" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_orient_landscape"
                style="@style/Widget.ComicReader.SheetSegment"
                android:text="@string/orientation_landscape" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sheet_rotate_spreads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:minHeight="48dp"
            android:text="@string/pref_rotate_spreads" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_more_settings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/settings" />
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
