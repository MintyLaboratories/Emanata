<?xml version="1.0" encoding="utf-8"?>
<!--
  The reader's toolbar and overflow menu. The toolbar holds what is reached while
  reading: the page's bookmark, the chapter drawer and the reader settings sheet,
  where every reading option lives. The overflow stays short: going somewhere,
  favorites, auto-scroll, the page's actions (also on a long-press of the page),
  the book's details and Settings.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/menu_bookmark"
        android:icon="@drawable/ic_bookmark_border"
        android:title="@string/menu_bookmark_add"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/menu_book_chapters"
        android:icon="@drawable/ic_toc"
        android:title="@string/chapters_title"
        android:visible="false"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/menu_tune"
        android:icon="@drawable/ic_tune"
        android:title="@string/menu_reader_settings"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/menu_jump"
        android:title="@string/menu_jump"
        app:showAsAction="never" />

    <item
        android:id="@+id/menu_chapters"
        android:title="@string/chapters_title"
        android:visible="false"
        app:showAsAction="never" />

    <item
        android:id="@+id/menu_bookmark_list"
        android:title="@string/menu_bookmark_list"
        app:showAsAction="never" />

    <item
        android:id="@+id/menu_favorites"
        android:title="@string/menu_favorites"
        app:showAsAction="never">
        <menu>
            <item
                android:id="@+id/menu_favorite"
                android:checkable="true"
                android:title="@string/favorite_this_comic" />
            <item
                android:id="@+id/menu_favorite_folder"
                android:checkable="true"
                android:title="@string/favorite_this_folder" />
        </menu>
    </item>

    <item
        android:id="@+id/menu_auto_scroll"
        android:checkable="true"
        android:title="@string/menu_auto_scroll"
        app:showAsAction="never" />

    <item
        android:id="@+id/menu_page_tools"
        android:title="@string/menu_group_page"
        app:showAsAction="never">
        <menu>
            <item
                android:id="@+id/menu_share_page"
                android:title="@string/menu_share_page" />
            <item
                android:id="@+id/menu_save_page"
                android:title="@string/menu_save_page" />
            <item
                android:id="@+id/menu_crop"
                android:title="@string/menu_crop" />
            <item
                android:id="@+id/menu_hide_page"
                android:title="@string/menu_hide_page" />
            <item
                android:id="@+id/menu_rotate"
                android:title="@string/menu_rotate" />
        </menu>
    </item>

    <item
        android:id="@+id/menu_book_info"
        android:title="@string/menu_book_info"
        app:showAsAction="never" />

    <item
        android:id="@+id/menu_settings"
        android:title="@string/menu_settings"
        app:showAsAction="never" />

</menu>
