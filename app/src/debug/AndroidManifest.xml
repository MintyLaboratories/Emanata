<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Checks a book read through the share provider, from a process of its own kept in the foreground; only the shell (DUMP) may start it. -->
        <service
            android:name="com.infinity.comicreader.debug.ShareCheckService"
            android:exported="true"
            android:foregroundServiceType="dataSync"
            android:process=":sharecheck"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
